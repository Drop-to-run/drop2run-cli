{
	"name": "drop2run",
	"version": "0.1.2",
	"description": "Publish a static site to Drop2Run from the command line.",
	"license": "MIT",
	"type": "module",
	"bin": {
		"drop2run": "bin/drop2run.mjs"
	},
	"files": [
		"bin",
		"dist"
	],
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public"
	},
	"homepage": "https://dropto.run",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Drop-to-run/drop2run-cli.git"
	},
	"bugs": {
		"url": "https://github.com/Drop-to-run/drop2run-cli/issues"
	},
	"keywords": [
		"static-site",
		"deploy",
		"hosting",
		"cli",
		"ai",
		"claude",
		"agent",
		"llm"
	],
	"scripts": {
		"prepublishOnly": "npm run build && npm test",
		"build": "vite build",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"lint": "biome check .",
		"format": "biome check --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@types/node": "^26.4.0",
		"typescript": "^5.9.3",
		"vite": "^7.2.1",
		"vitest": "^4.1.11"
	}
}
