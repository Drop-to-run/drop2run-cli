{
	"name": "@drop2run/mcp",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "MCP server that publishes a folder or a page to Drop2Run from inside a chat.",
	"bin": {
		"drop2run-mcp": "bin/drop2run-mcp.mjs"
	},
	"files": [
		"bin",
		"dist"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"lint": "biome check .",
		"format": "biome check --write .",
		"build": "vite build"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0",
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@types/node": "^26.4.0",
		"typescript": "^5.9.3",
		"vitest": "^4.1.11",
		"vite": "^7.2.1"
	}
}
