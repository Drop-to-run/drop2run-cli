{
	"name": "@drop2run/mcp",
	"version": "0.3.0",
	"description": "MCP server that publishes a folder or an HTML page to Drop2Run and returns a live URL.",
	"license": "MIT",
	"type": "module",
	"bin": {
		"drop2run-mcp": "bin/drop2run-mcp.mjs"
	},
	"files": [
		"bin",
		"dist"
	],
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public"
	},
	"homepage": "https://dropto.run",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Drop-to-run/drop2run-cli.git"
	},
	"bugs": {
		"url": "https://github.com/Drop-to-run/drop2run-cli/issues"
	},
	"keywords": [
		"mcp",
		"ai",
		"claude",
		"agent",
		"llm",
		"static-site",
		"deploy",
		"hosting"
	],
	"scripts": {
		"prepublishOnly": "npm run build && npm test",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"lint": "biome check .",
		"format": "biome check --write .",
		"build": "vite build"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0",
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@types/node": "^26.4.0",
		"typescript": "^5.9.3",
		"vitest": "^4.1.11",
		"vite": "^7.2.1"
	}
}
