{
	"$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
	"name": "run.dropto/drop2run",
	"title": "Drop2Run",
	"description": "Publishes a folder, an HTML page, or a markdown note as a static site and returns a live HTTPS URL.",
	"version": "0.4.3",
	"websiteUrl": "https://dropto.run",
	"repository": {
		"url": "https://github.com/Drop-to-run/drop2run-cli",
		"source": "github"
	},
	"icons": [
		{
			"src": "https://dropto.run/favicon-96x96.png",
			"mimeType": "image/png",
			"sizes": ["96x96"]
		}
	],
	"packages": [
		{
			"registryType": "npm",
			"registryBaseUrl": "https://registry.npmjs.org",
			"identifier": "@drop2run/mcp",
			"version": "0.4.3",
			"transport": {
				"type": "stdio"
			}
		}
	]
}
